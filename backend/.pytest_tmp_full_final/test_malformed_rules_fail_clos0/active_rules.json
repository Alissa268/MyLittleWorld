{"ruleset_id": "ttas_based_preliminary_screening_v1", "purpose": "\u5c08\u984c\u7528 TTAS-based \u6025\u8feb\u6027\u521d\u6b65\u7be9\u6aa2\uff1b\u4e0d\u5ba3\u7a31\u5b8c\u6574\u81e8\u5e8a TTAS \u5206\u7d1a\u3002", "selection_policy": {"winner": "\u53d6\u6240\u6709\u5df2\u555f\u7528\u4e14\u5b8c\u6574\u547d\u4e2d\u7684\u898f\u5247\u4e2d\u6700\u6025\u8feb\uff08\u6578\u5b57\u6700\u5c0f\uff09\u7684 level", "unknown_required_evidence": "\u4e0d\u5f97\u8996\u70ba false \u6216 normal\uff1b\u7d00\u9304 missing_evidence", "no_match": "level_candidate=null, status=insufficient_information", "never_default_to_level_4_or_5": true, "ai_may_set_level": false, "urgency_score_90_50_20": "removed"}, "rules": [{"rule_id": "TTAS-MOD-RESP-SEVERE", "official_code": null, "ttas_level": 1, "population": "all", "source_id": "missing-source", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u547c\u5438\uff1b\u5152\u7ae5\u73fe\u884c\u7e3d\u8868\u4ea6\u540c\u7d1a", "predicate": {"eq": ["respiratory_distress", "severe"]}, "required_fields": ["respiratory_distress"], "implementation_status": "reference_only", "hardening_reason": "respiratory distress severity requires clinical modifier assessment; no official numeric derivation threshold is available in the Phase 5 package"}, {"rule_id": "TTAS-MOD-RESP-MODERATE", "official_code": null, "ttas_level": 2, "population": "all", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u547c\u5438\uff1b\u5152\u7ae5\u73fe\u884c\u7e3d\u8868\u4ea6\u540c\u7d1a", "predicate": {"eq": ["respiratory_distress", "moderate"]}, "required_fields": ["respiratory_distress"], "implementation_status": "reference_only", "hardening_reason": "respiratory distress severity requires clinical modifier assessment; no official numeric derivation threshold is available in the Phase 5 package"}, {"rule_id": "TTAS-MOD-RESP-MILD", "official_code": null, "ttas_level": 3, "population": "all", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u547c\u5438\uff1b\u5152\u7ae5\u73fe\u884c\u7e3d\u8868\u4ea6\u540c\u7d1a", "predicate": {"eq": ["respiratory_distress", "mild"]}, "required_fields": ["respiratory_distress"], "implementation_status": "reference_only", "hardening_reason": "respiratory distress severity requires clinical modifier assessment; no official numeric derivation threshold is available in the Phase 5 package"}, {"rule_id": "TTAS-MOD-SHOCK", "official_code": null, "ttas_level": 1, "population": "all", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u8840\u884c\u52d5\u529b\uff1b\u5152\u7ae5\u73fe\u884c\u7e3d\u8868\u4ea6\u540c\u7d1a", "predicate": {"eq": ["hemodynamic_status", "shock"]}, "required_fields": ["hemodynamic_status"], "implementation_status": "reference_only", "hardening_reason": "shock is a clinical modifier and the package does not provide a complete objective derivation predicate"}, {"rule_id": "TTAS-MOD-HEMODYNAMIC-INSUFFICIENT", "official_code": null, "ttas_level": 2, "population": "all", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u8840\u884c\u52d5\u529b\uff1b\u5152\u7ae5\u73fe\u884c\u7e3d\u8868\u4ea6\u540c\u7d1a", "predicate": {"eq": ["hemodynamic_status", "insufficient"]}, "required_fields": ["hemodynamic_status"], "implementation_status": "reference_only", "hardening_reason": "hemodynamic insufficiency is a clinical modifier and the package does not provide a complete objective derivation predicate"}, {"rule_id": "TTAS-MOD-UNCONSCIOUS", "official_code": null, "ttas_level": 1, "population": "all", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u610f\u8b58\uff1b\u5152\u7ae5\u73fe\u884c\u7e3d\u8868\u4ea6\u540c\u7d1a", "predicate": {"between": ["gcs", 3, 8]}, "required_fields": ["gcs"], "implementation_status": "enabled", "hardening_reason": "runtime execution is restricted to the package's objective GCS range; AI-classified consciousness is not authoritative"}, {"rule_id": "TTAS-MOD-ALTERED-CONSCIOUSNESS", "official_code": null, "ttas_level": 2, "population": "all", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u610f\u8b58\uff1b\u5152\u7ae5\u73fe\u884c\u7e3d\u8868\u4ea6\u540c\u7d1a", "predicate": {"between": ["gcs", 9, 13]}, "required_fields": ["gcs"], "implementation_status": "enabled", "hardening_reason": "runtime execution is restricted to the package's objective GCS range; AI-classified consciousness is not authoritative"}, {"rule_id": "TTAS-MOD-TEMP-HIGH-EXTREME", "official_code": null, "ttas_level": 1, "population": "all", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u9ad4\u6eab\uff1b\u5152\u7ae5\u73fe\u884c\u7e3d\u8868\u4ea6\u540c\u7d1a", "predicate": {"gt": ["temperature_c", 41]}, "required_fields": ["temperature_c"], "implementation_status": "enabled"}, {"rule_id": "TTAS-MOD-TEMP-LOW-EXTREME", "official_code": null, "ttas_level": 1, "population": "all", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u9ad4\u6eab\uff1b\u5152\u7ae5\u73fe\u884c\u7e3d\u8868\u4ea6\u540c\u7d1a", "predicate": {"lt": ["temperature_c", 32]}, "required_fields": ["temperature_c"], "implementation_status": "enabled"}, {"rule_id": "TTAS-MOD-ADULT-FEVER-IMMUNOCOMPROMISED", "official_code": null, "ttas_level": 2, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u9ad4\u6eab", "predicate": {"all": [{"eq": ["fever", true]}, {"eq": ["immune_compromised", true]}]}, "required_fields": ["fever", "immune_compromised"], "implementation_status": "enabled"}, {"rule_id": "TTAS-MOD-ADULT-FEVER-ILL", "official_code": null, "ttas_level": 3, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u9ad4\u6eab", "predicate": {"all": [{"eq": ["fever", true]}, {"eq": ["ill_appearing", true]}]}, "required_fields": ["fever", "ill_appearing"], "implementation_status": "reference_only", "hardening_reason": "ill_appearing is a clinical assessment rather than an objective patient fact"}, {"rule_id": "TTAS-MOD-ADULT-FEVER-WELL", "official_code": null, "ttas_level": 4, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e00\u9ad4\u6eab", "predicate": {"all": [{"eq": ["fever", true]}, {"eq": ["ill_appearing", false]}]}, "required_fields": ["fever", "ill_appearing"], "implementation_status": "reference_only", "hardening_reason": "ill_appearing is a clinical assessment rather than an objective patient fact"}, {"rule_id": "TTAS-MOD-ADULT-CENTRAL-PAIN-SEVERE", "official_code": null, "ttas_level": 2, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e8c\u75bc\u75db", "predicate": {"all": [{"between": ["pain_score_0_10", 8, 10]}, {"eq": ["pain_location_class", "central"]}]}, "required_fields": ["pain_score_0_10", "pain_location_class"], "implementation_status": "reference_only", "hardening_reason": "central/peripheral pain classification is a clinical modifier not deterministically derived by this ruleset"}, {"rule_id": "TTAS-MOD-ADULT-PERIPHERAL-PAIN-SEVERE", "official_code": null, "ttas_level": 3, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e8c\u75bc\u75db", "predicate": {"all": [{"between": ["pain_score_0_10", 8, 10]}, {"eq": ["pain_location_class", "peripheral"]}]}, "required_fields": ["pain_score_0_10", "pain_location_class"], "implementation_status": "reference_only", "hardening_reason": "central/peripheral pain classification is a clinical modifier not deterministically derived by this ruleset"}, {"rule_id": "TTAS-MOD-ADULT-CENTRAL-PAIN-MODERATE", "official_code": null, "ttas_level": 3, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e8c\u75bc\u75db", "predicate": {"all": [{"between": ["pain_score_0_10", 4, 7]}, {"eq": ["pain_location_class", "central"]}]}, "required_fields": ["pain_score_0_10", "pain_location_class"], "implementation_status": "reference_only", "hardening_reason": "central/peripheral pain classification is a clinical modifier not deterministically derived by this ruleset"}, {"rule_id": "TTAS-MOD-ADULT-PERIPHERAL-PAIN-MODERATE", "official_code": null, "ttas_level": 4, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e8c\u75bc\u75db", "predicate": {"all": [{"between": ["pain_score_0_10", 4, 7]}, {"eq": ["pain_location_class", "peripheral"]}]}, "required_fields": ["pain_score_0_10", "pain_location_class"], "implementation_status": "reference_only", "hardening_reason": "central/peripheral pain classification is a clinical modifier not deterministically derived by this ruleset"}, {"rule_id": "TTAS-MOD-ADULT-CENTRAL-PAIN-MILD", "official_code": null, "ttas_level": 4, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e8c\u75bc\u75db", "predicate": {"all": [{"lt": ["pain_score_0_10", 4]}, {"eq": ["pain_location_class", "central"]}]}, "required_fields": ["pain_score_0_10", "pain_location_class"], "implementation_status": "reference_only", "hardening_reason": "central/peripheral pain classification is a clinical modifier not deterministically derived by this ruleset"}, {"rule_id": "TTAS-MOD-ADULT-PERIPHERAL-PAIN-MILD", "official_code": null, "ttas_level": 5, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e8c\u75bc\u75db", "predicate": {"all": [{"lt": ["pain_score_0_10", 4]}, {"eq": ["pain_location_class", "peripheral"]}]}, "required_fields": ["pain_score_0_10", "pain_location_class"], "implementation_status": "reference_only", "hardening_reason": "central/peripheral pain classification is a clinical modifier not deterministically derived by this ruleset"}, {"rule_id": "TTAS-MOD-ADULT-HIGH-RISK-MECHANISM", "official_code": null, "ttas_level": 2, "population": "adult", "source_id": "mohw_ttas_105_general", "official_locator": "\u6210\u4eba\u7e3d\u8868\u8868\u4e09\u9ad8\u5371\u96aa\u6027\u53d7\u50b7\u6a5f\u8f49", "predicate": {"eq": ["high_risk_injury_mechanism", true]}, "required_fields": ["high_risk_injury_mechanism"], "implementation_status": "reference_only", "hardening_reason": "high-risk mechanism is a clinical classification without a complete package predicate"}, {"rule_id": "TTAS-PED-FEVER-LT3M", "official_code": null, "ttas_level": 2, "population": "pediatric", "source_id": "mohw_ttas_107_general_patch", "official_locator": "107\u7e3d\u8868\u5152\u7ae5\u9ad4\u6eab\uff1a\u5c0f\u65bc3\u500b\u6708", "predicate": {"all": [{"lt": ["age_months", 3]}, {"any": [{"gt": ["temperature_c", 38]}, {"lt": ["temperature_c", 36]}]}]}, "required_fields": ["age_months", "temperature_c"], "implementation_status": "enabled"}, {"rule_id": "TTAS-PED-FEVER-3M-3Y-IMMUNE-OR-ILL", "official_code": null, "ttas_level": 2, "population": "pediatric", "source_id": "mohw_ttas_107_general_patch", "official_locator": "107\u7e3d\u8868\u5152\u7ae5\u9ad4\u6eab\uff1a3\u500b\u6708\u81f33\u6b72", "predicate": {"all": [{"between": ["age_months", 3, 36]}, {"gt": ["temperature_c", 38]}, {"any": [{"eq": ["immune_compromised", true]}, {"eq": ["ill_appearing", true]}]}]}, "required_fields": ["age_months", "temperature_c", "immune_compromised|ill_appearing"], "implementation_status": "reference_only", "hardening_reason": "the combined predicate permits AI-supplied ill_appearing to determine level"}, {"rule_id": "TTAS-PED-FEVER-GT3Y-IMMUNE", "official_code": null, "ttas_level": 2, "population": "pediatric", "source_id": "mohw_ttas_107_general_patch", "official_locator": "107\u7e3d\u8868\u5152\u7ae5\u9ad4\u6eab\uff1a\u5927\u65bc3\u6b72\u514d\u75ab\u529f\u80fd\u7f3a\u9677", "predicate": {"all": [{"gt": ["age_years", 3]}, {"gt": ["temperature_c", 38]}, {"eq": ["immune_compromised", true]}]}, "required_fields": ["age_years", "temperature_c", "immune_compromised"], "implementation_status": "enabled"}, {"rule_id": "TTAS-PED-FEVER-3M-3Y-WELL", "official_code": null, "ttas_level": 3, "population": "pediatric", "source_id": "mohw_ttas_107_general_patch", "official_locator": "107\u7e3d\u8868\u5152\u7ae5\u9ad4\u6eab\uff1a3\u500b\u6708\u81f33\u6b72\u7121\u75c5\u5bb9", "predicate": {"all": [{"between": ["age_months", 3, 36]}, {"gt": ["temperature_c", 38]}, {"eq": ["ill_appearing", false]}]}, "required_fields": ["age_months", "temperature_c", "ill_appearing"], "implementation_status": "reference_only", "hardening_reason": "ill_appearing is a clinical assessment rather than an objective patient fact"}, {"rule_id": "TTAS-PED-FEVER-GT3Y-ILL", "official_code": null, "ttas_level": 3, "population": "pediatric", "source_id": "mohw_ttas_107_general_patch", "official_locator": "107\u7e3d\u8868\u5152\u7ae5\u9ad4\u6eab\uff1a\u5927\u65bc3\u6b72\u6709\u75c5\u5bb9", "predicate": {"all": [{"gt": ["age_years", 3]}, {"gt": ["temperature_c", 38]}, {"eq": ["ill_appearing", true]}]}, "required_fields": ["age_years", "temperature_c", "ill_appearing"], "implementation_status": "reference_only", "hardening_reason": "ill_appearing is a clinical assessment rather than an objective patient fact"}, {"rule_id": "TTAS-PED-FEVER-GT3Y-WELL", "official_code": null, "ttas_level": 4, "population": "pediatric", "source_id": "mohw_ttas_107_general_patch", "official_locator": "107\u7e3d\u8868\u5152\u7ae5\u9ad4\u6eab\uff1a\u5927\u65bc3\u6b72\u7121\u75c5\u5bb9", "predicate": {"all": [{"gt": ["age_years", 3]}, {"gt": ["temperature_c", 38]}, {"eq": ["ill_appearing", false]}]}, "required_fields": ["age_years", "temperature_c", "ill_appearing"], "implementation_status": "reference_only", "hardening_reason": "ill_appearing is a clinical assessment rather than an objective patient fact"}, {"rule_id": "TTAS-A020210", "official_code": "A020210", "ttas_level": 2, "population": "adult", "source_id": "mohw_ttas_105_adult_nontrauma", "official_locator": "A0202 \u80f8\u75db/\u80f8\u60b6", "predicate": {"eq": ["cardiac_chest_pain_suspected", true]}, "required_fields": ["cardiac_chest_pain_suspected"], "implementation_status": "reference_only", "hardening_reason": "cardiac chest pain suspected is a clinical conclusion, not a directly observable fact"}, {"rule_id": "TTAS-A020211", "official_code": "A020211", "ttas_level": 2, "population": "adult", "source_id": "mohw_ttas_105_adult_nontrauma", "official_locator": "A0202 \u80f8\u75db/\u80f8\u60b6", "predicate": {"eq": ["tearing_pain", true]}, "required_fields": ["tearing_pain"], "implementation_status": "reference_only", "hardening_reason": "A0202 is the chest pain/tightness complaint; tearing pain alone does not establish that complaint context"}, {"rule_id": "TTAS-A020407", "official_code": "A020407", "ttas_level": 2, "population": "adult", "source_id": "mohw_ttas_105_adult_nontrauma", "official_locator": "A0204 \u9ad8\u8840\u58d3\u6025\u75c7", "predicate": {"all": [{"any": [{"gte": ["sbp_mmhg", 220]}, {"gte": ["dbp_mmhg", 130]}]}, {"eq": ["cardiac_chest_pain_suspected", true]}]}, "required_fields": ["sbp_mmhg|dbp_mmhg", "symptomatic_hypertension"], "implementation_status": "reference_only", "note": "\u5b98\u65b9\u75c7\u72c0\u96c6\u5408\u4e0d\u53ea\u80f8\u75db\uff1b\u5be6\u4f5c\u524d\u9700\u4ee5\u7368\u7acb symptomatic_hypertension evidence \u53d6\u4ee3\u6b64\u66ab\u5b58 predicate\u3002"}, {"rule_id": "TTAS-A020409", "official_code": "A020409", "ttas_level": 3, "population": "adult", "source_id": "mohw_ttas_105_adult_nontrauma", "official_locator": "A0204 \u9ad8\u8840\u58d3\u6025\u75c7", "predicate": {"all": [{"any": [{"gte": ["sbp_mmhg", 220]}, {"gte": ["dbp_mmhg", 130]}]}, {"eq": ["symptomatic_hypertension", false]